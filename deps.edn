{:paths ["src" "resources" "target/resources"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.4"}
        ai.dyal/hyper          {:mvn/version "0.2.2"}
        cheshire/cheshire      {:mvn/version "6.1.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.13"}}
 :aliases
 {:dev   {:extra-paths ["dev"]
          :extra-deps  {nrepl/nrepl       {:mvn/version "1.3.1"}
                        cider/cider-nrepl {:mvn/version "0.52.1"}}
          :jvm-opts    ["-XX:-OmitStackTraceInFastThrow"]}
  :nrepl {:main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"
                      "--interactive"]}
  :prod  {:jvm-opts  ["-XX:-OmitStackTraceInFastThrow"
                      "-XX:+CrashOnOutOfMemoryError"]
          :main-opts ["-m" "nz.zhealth.app"]}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
          :ns-default build}}}
